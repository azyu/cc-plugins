{
  "name": "codex-review-hook",
  "description": "Automatically run OpenAI Codex review before git commit",
  "version": "1.1.0",
  "author": { "name": "jinto" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/codex-review.sh"
          }
        ]
      }
    ]
  }
}
